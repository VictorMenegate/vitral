    for _, dirigida in pendentes:
        emitir({"type": "assistant", "message": {"content": [
            {"type": "text", "text": f"(claude falso) dirigido no meio do turno: {dirigida[:120]}"}]}})


def titular(pedido):
    """O `generate_session_title` como o 2.1.328 (medido em 23/11/2026): responde com o título e,
    com `persist`, grava a linha `ai-title` no arquivo da sessão. Com menos de 10 letras na
    descrição ele não titula (`{"title": null}`)."""
    corpo = pedido.get("request", {})
    descricao = (corpo.get("description") or "").strip()
    titulo = None
    if len(descricao) >= 10:
        pedido_na_mensagem = re.search(r"\[titulo ([^\]]+)\]", descricao)
        titulo = (pedido_na_mensagem.group(1).strip() if pedido_na_mensagem else os.environ.get("CLAUDE_FALSO_TITULO")) \
            or "Sobre " + " ".join(descricao.split()[:3])
    anotar({"generate_session_title": descricao[:120], "persist": corpo.get("persist"), "titulo": titulo})
    # Só numa pasta de configuração de mentira: o ~/.claude de verdade nunca é tocado.
    pasta_de_config = os.environ.get("CLAUDE_CONFIG_DIR")
    if titulo and corpo.get("persist") and pasta_de_config:
        projeto = os.path.join(pasta_de_config, "projects", re.sub(r"[^A-Za-z0-9]", "-", os.getcwd()))
        os.makedirs(projeto, exist_ok=True)
        with open(os.path.join(projeto, sessao + ".jsonl"), "a") as gravada:
            gravada.write(json.dumps({"type": "ai-title", "aiTitle": titulo, "sessionId": sessao}) + "\n")
    responder(pedido, {"title": titulo})
