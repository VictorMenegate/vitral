#!/usr/bin/env python3
"""Um `claude` de mentira para a bancada (CLAUDE_FALSO=1): responde a versão, recusa o
`auth status` e, num turno, anota a mensagem em notas-do-chat.md na pasta onde roda (a cópia,
ou a pasta direta) e responde em stream-json, sem chamar a API. Com "[demora]" na mensagem, leva
10 s. Os argumentos e o ambiente de cada turno vão para $XDG_STATE_HOME/claude-falso.log.

Com `[ferramenta <Nome> <detalhe>]` (Read, Edit, Write, Bash, Grep, Glob, WebFetch, Task...), faz de
conta que usa a ferramenta: manda o tool_use, espera 4 s (ou os segundos de `[ferramenta ... | 8]`) e
manda o tool_result. Serve para ver na bancada a linha do turno ("Lendo motor.rs…", "Rodando: cargo
test…") sem chamar a API.

Ferramentas do Vitral: cada `[mcp <nome> <json>]` da mensagem (fora das linhas citadas com "> ")
vira uma chamada de verdade ao MCP do Vitral (a URL do --mcp-config), com o tool_use e o
tool_result no stream. E, sem precisar pedir:
- no chat de projeto, o pedido do Mestre (ou o ajuste, ou o lembrete) termina com entregar_tarefa,
  todos os critérios "feito" (o número deles fica guardado por sessão para o ajuste);
- no Mestre, o relatório de uma verificação que FALHOU na rodada 1 vira pedir_ajuste;
- no chat de projeto, o relatório de um ajudante ("Ajudante #N ... terminou") vira aprovar_tarefa N
  (`[nao-aprovar]` desliga), ou pedir_ajuste N na rodada 1 com `[ajuste-uma-vez]` no relatório; a
  pergunta de um ajudante ("Pergunta do ajudante #N") ganha resposta por mensagem_para_chat;
- o Mestre não escreve arquivo nenhum; o ajudante escreve em notas-do-t<N>.md (o nome da cópia dele),
  para dois ajudantes não mexerem no mesmo arquivo. A anotação vem antes das ferramentas: um
  criar_tarefa ou aprovar_tarefa na mesma vez já encontra a pasta com o que ela anotou.
`claude update` também é de mentira, para ver o Atualizar das Configurações sem mexer na
instalação de verdade: CLAUDE_FALSO_UPDATE escolhe a resposta (nova, em-dia, sem-permissao,
sem-rede, npm, path, calado; "demora:" na frente leva 6 s, que é o tempo de ver o spinner) e as
frases são as do Claude Code 2.1.318. O que instala versão nova anota a 2.1.320 em
$XDG_STATE_HOME/claude-falso-versao, e o `--version` passa a dizer ela: é assim que se vê o Vitral
reler a versão sem reiniciar. CLAUDE_FALSO_VERSAO escolhe a versão de antes (o padrão é 2.1.300;
com 2.1.278 as versões exatas de modelo aparecem desabilitadas).
Como revisor (--json-schema), devolve o parecer "aprovar" (ou "ajustar", com "[revisor-ajustar]"
no pedido) sem mexer em nada."""
import json
import os
import re
import sys
import threading
import time
import urllib.request

args = sys.argv[1:]
# A versão que ele diz: a do CLAUDE_FALSO_VERSAO ou, depois de um `update` que instalou, a que o
# update deixou anotada (é assim que se vê o Vitral reler a versão sem reiniciar).
instalada = os.path.join(os.environ.get("XDG_STATE_HOME", "/nao-existe"), "claude-falso-versao")


def versao_falsa():
    try:
        with open(instalada) as arquivo:
            return arquivo.read().strip()
    except OSError:
        return os.environ.get("CLAUDE_FALSO_VERSAO", "2.1.300")


if "--version" in args:
    print(versao_falsa() + " (Claude Code)")
    sys.exit(0)
if args[:1] == ["auth"]:
    sys.exit(1)
# `claude update` de mentira, para ver o Atualizar das Configurações sem mexer na instalação de
# verdade: CLAUDE_FALSO_UPDATE escolhe a resposta (as frases são as do Claude Code 2.1.318).
# Com "demora:" na frente (ex.: demora:nova), leva 6 s, que é o tempo de ver o spinner.
if args[:1] == ["update"]:
    qual = os.environ.get("CLAUDE_FALSO_UPDATE", "nova")
    if qual.startswith("demora:"):
        qual = qual[len("demora:"):]
        time.sleep(6)
    atual = versao_falsa()
    print(f"Current version: {atual}")
    print(f"Checking for updates to stable version...")
    saidas = {
        "nova": ([f"Successfully updated from {atual} to version 2.1.320"], 0),
        "em-dia": ([f"Claude Code is up to date ({atual})"], 0),
        "sem-permissao": (["Error: Failed to install native update",
                           'Try running "claude doctor" for diagnostics'], 1),
        "sem-rede": (["Could not check for updates (network check skipped or unavailable).",
                      "To update manually, run:", "  npm install -g @anthropic-ai/claude-code"], 1),
        "npm": ([f"Update available: 2.1.320", "To update, run:",
                 "  npm install -g @anthropic-ai/claude-code"], 0),
        "path": ([f"Successfully updated from {atual} to version 2.1.320",
                  "Warning: ~/.local/bin is not in your PATH",
                  """Run: echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc"""], 0),
        "calado": ([], 0),
    }
    linhas, codigo = saidas.get(qual, saidas["nova"])
    for linha in linhas:
        print(linha)
    if any("Successfully updated" in linha for linha in linhas):
        try:
            with open(instalada, "w") as arquivo:
                arquivo.write("2.1.320")
        except OSError:
            pass
    sys.exit(codigo)

estado = os.environ.get("XDG_STATE_HOME", "/nao-existe")
registro = os.path.join(estado, "claude-falso.log")


def anotar(valor):
    try:
        with open(registro, "a") as saida:
            saida.write(json.dumps(valor, ensure_ascii=False) + "\n")
    except OSError:
        pass


if "--json-schema" in args:
    pedido = args[-1] if args else ""
    ajustar = "[revisor-ajustar]" in pedido
    parecer = {
        "veredito": "ajustar" if ajustar else "aprovar",
        "resumo": "(claude falso) revisão de mentira",
        "problemas": [{"arquivo": "notas-do-chat.md", "linha": 1, "gravidade": "media",
                       "descricao": "(claude falso) pediu ajuste"}] if ajustar else [],
    }
    anotar({"cwd": os.getcwd(), "revisor": parecer["veredito"]})
    print(json.dumps({"type": "result", "is_error": False, "result": "", "structured_output": parecer}))
    sys.exit(0)


def emitir(valor):
    print(json.dumps(valor, ensure_ascii=False), flush=True)


def valor_de(chave):
    return args[args.index(chave) + 1] if chave in args and args.index(chave) + 1 < len(args) else None


try:
    url = json.loads(valor_de("--mcp-config") or "{}")["mcpServers"]["vitral"]["url"]
except (ValueError, KeyError, TypeError):
    url = None
papel = url.split("/mcp/", 1)[1].split("/", 1)[0] if url and "/mcp/" in url else ""

linha = sys.stdin.readline()
fim_da_entrada = threading.Event()


def ouvir_entrada():
    """O Parar do Vitral: o `interrupt` pela entrada (como no de verdade, 2.1.278) responde, fecha o
    turno com erro e sai. Outra mensagem do usuário no meio do turno (o Enviar com ele rodando) é
    absorvida nele, como no de verdade, e só responde uma linha dizendo que foi dirigida. A entrada
    fechada (o fim do turno) solta o fim lá embaixo."""
    for pedido in sys.stdin:
        try:
            pedido = json.loads(pedido)
        except ValueError:
            continue
        if pedido.get("type") == "control_request" and pedido.get("request", {}).get("subtype") == "interrupt":
            anotar({"interrupt": pedido.get("request_id")})
            emitir({"type": "control_response", "response": {"subtype": "success", "request_id": pedido.get("request_id"), "response": {}}})
            emitir({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "", "total_cost_usd": 0.0})
            os._exit(1)
        if pedido.get("type") == "user":
            try:
                partes = pedido["message"]["content"]
                dirigida = "\n".join(b.get("text", "") for b in partes if b.get("type") == "text").strip()
            except (KeyError, TypeError):
                dirigida = ""
            if dirigida:
                anotar({"dirigida": dirigida[:200]})
                emitir({"type": "assistant", "message": {"content": [
                    {"type": "text", "text": f"(claude falso) dirigido no meio do turno: {dirigida[:120]}"}]}})
    fim_da_entrada.set()


threading.Thread(target=ouvir_entrada, daemon=True).start()
try:
    conteudo = json.loads(linha)["message"]["content"]
    texto = "\n".join(b.get("text", "") for b in conteudo if b.get("type") == "text")
except (ValueError, KeyError, TypeError):
    texto = ""
pedido = next((l.strip() for l in reversed(texto.splitlines()) if l.strip() and not l.startswith("[")), "")
prompt = valor_de("--append-system-prompt-file")
sessao = valor_de("--session-id") or valor_de("--resume") or "falsa"
# A conversa trazida do Claude Code continua numa cópia (--resume <id> --fork-session --session-id
# <nova>): como no de verdade, a sessão nova nasce com o que a original tinha, ao lado dela. Só com
# um CLAUDE_CONFIG_DIR de mentira: o ~/.claude de verdade nunca é tocado.
config = os.environ.get("CLAUDE_CONFIG_DIR")
if "--fork-session" in args and config and valor_de("--resume") and valor_de("--session-id"):
    import glob
    import shutil
    for original in glob.glob(os.path.join(config, "projects", "*", valor_de("--resume") + ".jsonl")):
        shutil.copyfile(original, os.path.join(os.path.dirname(original), valor_de("--session-id") + ".jsonl"))
anotar({
    "cwd": os.getcwd(),
    "args": args,
    "VITRAL_PORT": os.environ.get("VITRAL_PORT"),
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": os.environ.get("CLAUDE_CODE_DISABLE_AUTO_MEMORY"),
    "prompt": open(prompt).read()[:600] if prompt else None,
    "pedido": pedido,
})

emitir({"type": "system", "subtype": "init", "model": "claude-falso", "session_id": sessao,
        "slash_commands": ["clear", "compact"], "claude_code_version": "2.1.300", "tools": ["Read", "Edit", "Bash"]})
if "[demora]" in texto:
    time.sleep(10)

chamadas = []


def chamar(nome, argumentos):
    n = len(chamadas) + 1
    id_ = f"toolu_falso_{n}"
    emitir({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": id_, "name": f"mcp__vitral__{nome}", "input": argumentos}]}})
    corpo = json.dumps({"jsonrpc": "2.0", "id": n, "method": "tools/call",
                        "params": {"name": nome, "arguments": argumentos}}).encode()
    try:
        req = urllib.request.Request(url, data=corpo, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=300) as r:
            resposta = json.loads(r.read())["result"]
        resultado, erro = resposta["content"][0]["text"], bool(resposta.get("isError"))
    except Exception as e:  # noqa: BLE001 (a bancada só anota)
        resultado, erro = f"(claude falso) a chamada falhou: {e}", True
    emitir({"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": id_, "content": resultado, "is_error": erro}]}})
    chamadas.append({"nome": nome, "erro": erro, "resultado": resultado[:300]})
    return resultado, erro


# `[ferramenta Nome detalhe]` ou `[ferramenta Nome detalhe | 8]` (segundos até o resultado).
FERRAMENTA = re.compile(r"\[ferramenta ([A-Za-z]+) ([^\]|]+?)(?:\s*\|\s*(\d+))?\]")


def entrada_da_ferramenta(nome, detalhe):
    """O campo que o Vitral lê para montar o resumo de cada ferramenta."""
    # O Edit e o Write levam o que mudou: é o que a conversa mostra ao abrir a linha.
    if nome == "Edit":
        return {"file_path": detalhe,
                "old_string": "    total = subtotal\n    return total",
                "new_string": "    desconto = aplicar_cupom(cupom, subtotal)\n    total = subtotal - desconto\n    return total"}
    if nome == "Write":
        return {"file_path": detalhe, "content": "# criado pelo claude falso\nprint('ola')\n"}
    if nome in ("Read", "NotebookEdit"):
        return {"file_path": detalhe}
    if nome in ("Bash", "BashOutput"):
        return {"command": detalhe}
    if nome in ("Grep", "Glob"):
        return {"pattern": detalhe}
    if nome == "WebFetch":
        return {"url": detalhe}
    if nome == "WebSearch":
        return {"query": detalhe}
    if nome in ("Task", "Agent", "Workflow"):
        return {"description": detalhe}
    return {"detalhe": detalhe}


def fingir_ferramentas(texto):
    """Faz de conta que usa cada ferramenta pedida, uma de cada vez, com a espera entre o
    tool_use e o tool_result: é nessa janela que a conversa mostra o que ele está fazendo."""
    for i, (nome, detalhe, segundos) in enumerate(FERRAMENTA.findall(texto), start=1):
        detalhe = detalhe.strip()
        id_ = f"toolu_falso_f{i}"
        emitir({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": id_, "name": nome, "input": entrada_da_ferramenta(nome, detalhe)}]}})
        time.sleep(int(segundos) if segundos else 4)
        emitir({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": id_, "content": f"(claude falso) {nome} em {detalhe}"}]}})


def diretivas(texto):
    """Os `[mcp nome {json}]` do texto, fora das linhas citadas."""
    proprio = "\n".join(l for l in texto.splitlines() if not l.lstrip().startswith(">"))
    achadas = []
    decodificador = json.JSONDecoder()
    for m in re.finditer(r"\[mcp (\w+)", proprio):
        resto = proprio[m.end():].lstrip()
        argumentos = {}
        if resto.startswith("{"):
            try:
                argumentos, _ = decodificador.raw_decode(resto)
            except ValueError:
                continue
        achadas.append((m.group(1), argumentos))
    return achadas


guardado = os.path.join(estado, f"claude-falso-{sessao}.json")
if papel != "mestre":
    arquivo = f"notas-do-{os.path.basename(os.getcwd())}.md" if papel == "trabalhador" else "notas-do-chat.md"
    # Num pedido do Mestre, o título e o pedido (a verificação dele procura uma palavra deles), não a
    # última linha ("Quando terminar e verificar, chame entregar_tarefa.").
    nota = pedido[:80]
    if "Pedido do Mestre (" in texto:
        corpo = texto.split("Pedido do Mestre (", 1)[1].split("\n", 1)[-1].split("Critérios de aceitação:", 1)[0]
        nota = " · ".join(l.strip() for l in corpo.splitlines() if l.strip())[:160] or nota
    with open(arquivo, "a") as notas:
        notas.write(f"- {nota}\n")
else:
    arquivo = None
fingir_ferramentas(texto)
if url:
    for nome, argumentos in diretivas(texto):
        chamar(nome, argumentos)
    if papel == "projeto" and "[nao-entregar]" not in texto and any(
            marca in texto for marca in ("Pedido do Mestre", "Ajuste pedido pelo Mestre", "Se já terminou o pedido")):
        bloco = texto.split("Critérios de aceitação:", 1)
        criterios = len(re.findall(r"^\d+\. ", bloco[1], re.M)) if len(bloco) > 1 else 0
        if criterios:
            with open(guardado, "w") as saida:
                json.dump({"criterios": criterios}, saida)
        else:
            try:
                criterios = json.load(open(guardado))["criterios"]
            except (OSError, ValueError, KeyError):
                criterios = 1
    if papel == "projeto" and "[nao-aprovar]" not in texto:
        for bloco in re.split(r"(?=Ajudante #\d+ )", texto):
            achado = re.search(r"aprovar_tarefa (\d+) \(junta na sua pasta\)", bloco)
            if not achado:
                continue
            n = int(achado.group(1))
            if "[ajuste-uma-vez]" in bloco and "terminou a rodada 1" in bloco:
                chamar("pedir_ajuste", {"tarefa": n, "feedback": "(claude falso) anote mais uma linha."})
            else:
                chamar("aprovar_tarefa", {"tarefa": n})
    if papel == "projeto":
        for n in re.findall(r"Pergunta do ajudante #(\d+)", texto):
            chamar("mensagem_para_chat", {"chat": n, "texto": "(claude falso) resposta: siga com o que tem."})
    if papel == "mestre":
        decidir = re.search(r"Decida: aprovar_tarefa (\d+)", texto)
        if decidir and "FALHOU" in texto and "· rodada 1" in texto:
            chamar("pedir_ajuste", {"tarefa": int(decidir.group(1)),
                                    "feedback": "(claude falso) a verificação falhou: anote mais uma linha."})

if url and papel == "projeto" and "[nao-entregar]" not in texto and any(
        marca in texto for marca in ("Pedido do Mestre", "Ajuste pedido pelo Mestre", "Se já terminou o pedido")):
    chamar("entregar_tarefa", {
        "resumo": "(claude falso) anotei o pedido em notas-do-chat.md",
        "como_verificou": "li o arquivo de volta",
        "criterios": [{"indice": i, "estado": "feito", "evidencia": "notas-do-chat.md"} for i in range(1, criterios + 1)],
    })

if papel == "mestre":
    if "terminou:" in texto and "A divisão" in texto:
        resposta = "(claude falso) Resumo por projeto: " + texto.split("terminou:", 1)[1].split("Responda", 1)[0].strip()
    else:
        resposta = f"(claude falso) Mestre: {pedido[:80]}"
    if chamadas:
        resposta += " | ferramentas: " + ", ".join(f"{c['nome']}{' (erro)' if c['erro'] else ''}" for c in chamadas)
else:
    pasta = os.getcwd()
    casa = os.path.expanduser("~")
    if pasta == casa or pasta.startswith(casa + "/"):
        pasta = "~" + pasta[len(casa):]
    resposta = f"(claude falso) Anotei em {arquivo}, na pasta {pasta}: {pedido[:80]}"
    if chamadas:
        resposta += " | ferramentas: " + ", ".join(f"{c['nome']}{' (erro)' if c['erro'] else ''}" for c in chamadas)
anotar({"papel": papel, "chamadas": chamadas})
emitir({"type": "assistant", "message": {"content": [{"type": "text", "text": resposta}],
                                         "usage": {"input_tokens": 1200}}})
emitir({"type": "result", "is_error": False, "result": resposta, "total_cost_usd": 0.0,
        "modelUsage": {"claude-falso": {"contextWindow": 200000}}})
# O Vitral fecha a entrada no fim do turno; sem isso, sai sozinho depois de um tempo.
fim_da_entrada.wait(30)
