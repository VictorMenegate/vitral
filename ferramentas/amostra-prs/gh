#!/usr/bin/env -S python3 -I
# O gh da amostra de PRs da bancada (AMOSTRA=prs no ferramentas/bancada.sh): responde, sem rede, o
# que o Vitral lê do GitHub (o login, os repositórios, a consulta do vigia, o detalhe, os
# comentários, os checks e os logs dos PRs, as issues) a partir do $AMOSTRA_GITHUB que o
# preparar.py gera junto com o estado.json, para os PRs ficarem como o estado diz. Nada é escrito:
# criar, mudar, mesclar ou comentar sai com erro. Cada chamada vai para $XDG_STATE_HOME/gh-amostra.log.
import json, os, re, sys

args = sys.argv[1:]
estado = os.environ.get("XDG_STATE_HOME", "/tmp")
with open(os.path.join(estado, "gh-amostra.log"), "a") as registro:
    registro.write("gh " + " ".join(args[:3]) + "\n")
dados = json.load(open(os.environ["AMOSTRA_GITHUB"]))


def sair(texto, codigo=0):
    if texto is not None:
        print(texto if isinstance(texto, str) else json.dumps(texto, ensure_ascii=False))
    sys.exit(codigo)


def erro(texto, codigo=1):
    print(texto, file=sys.stderr)
    sys.exit(codigo)


def opcao(nome):
    return args[args.index(nome) + 1] if nome in args else None


repo = opcao("-R")
comando = " ".join(a for a in args[:2])
# O número do PR ou da issue: o primeiro argumento só de dígitos depois do comando (o Vitral põe o
# "-R dono/nome" logo depois do comando, antes dele).
numero = next((a for a in args[2:] if a.isdigit()), "")
pr_de = lambda n: dados["prs"].get(f"{repo}#{n}")

if comando == "auth status":
    sair(dados["login"])
if comando == "repo view":
    r = dados["repos"].get(args[2])
    sair(r) if r else erro(f"GraphQL: Could not resolve to a Repository with the name '{args[2]}'. (repository)")
if args[:1] == ["api"]:
    caminho = next((a for a in args[1:] if not a.startswith("-") and args[args.index(a) - 1] not in ("--cache", "--jq", "-H", "-f", "-F")), "")
    if args[1:2] == ["graphql"]:
        consulta = sys.stdin.read()
        dono = (opcao("-f") or "owner=").split("=", 1)[1]
        nome = next((a.split("=", 1)[1] for a in args if a.startswith("name=")), "")
        alvo = f"{dono}/{nome}"
        nos = {}
        for apelido, numero in re.findall(r"(p\d+): pullRequest\(number:(\d+)\)", consulta):
            p = dados["prs"].get(f"{alvo}#{numero}")
            nos[apelido] = p["no"] if p else None
        erros = [{"type": "NOT_FOUND", "path": ["repository", a], "message": "não existe na amostra"} for a, n in nos.items() if n is None]
        resposta = {"data": {"repository": nos, "rateLimit": {"cost": 1, "remaining": 4999, "resetAt": "2030-01-01T00:00:00Z"}}}
        if erros:
            resposta["errors"] = erros
        sair(resposta, 1 if erros else 0)
    if caminho == "rate_limit":
        sair({"resources": {"core": {"limit": 5000, "remaining": 4999, "reset": 1893456000}, "graphql": {"limit": 5000, "remaining": 4999, "reset": 1893456000}}})
    m = re.match(r"repos/([^/]+/[^/]+)/(.*)", caminho)
    if m and "-X" not in args and "--method" not in args:
        alvo, resto = m.groups()
        if resto.startswith("actions/workflows"):
            sair(str(dados["workflows"].get(alvo, 0)))
        if resto.startswith("branches"):
            sair("\n".join(dados["ramos"].get(alvo, ["main"])))
        c = re.match(r"(pulls|issues)/(\d+)/(comments|reviews)", resto)
        if c:
            p = dados["prs"].get(f"{alvo}#{c.group(2)}") or {}
            chave = {"pulls/comments": "em_linha", "issues/comments": "gerais", "pulls/reviews": "revisoes"}[f"{c.group(1)}/{c.group(3)}"]
            sair([p.get(chave, [])])
        if resto.startswith("check-runs/"):
            sair({"t": "", "s": dados["logs"].get(resto.split("/")[1], ""), "x": "", "st": "completed"})
    erro("gh da amostra: esta bancada não escreve no GitHub nem lê o que a amostra não tem")
if comando == "pr view":
    p = pr_de(numero)
    sair(p["view"]) if p else erro(f"GraphQL: Could not resolve to a PullRequest with the number of {numero}. (repository.pullRequest)")
if comando == "pr checks":
    p = pr_de(numero) or {}
    lista = p.get("checks", [])
    if not lista:
        erro("no checks reported on the 'x' branch")
    codigo = 8 if any(c["bucket"] == "pending" for c in lista) else 1 if any(c["bucket"] == "fail" for c in lista) else 0
    sair(lista, codigo)
if comando == "pr diff":
    sair((pr_de(numero) or {}).get("diff", ""))
if comando == "pr list":
    sair([])
if comando == "run view":
    sair(dados["logs"].get(opcao("--job"), "o log não está na amostra"))
if comando == "issue list":
    lista = dados["issues"].get(repo, [])
    estado_pedido = (opcao("--state") or "open").upper()
    sair([i for i in lista if i["state"] == estado_pedido])
if comando == "issue view":
    i = dados["issue"].get(f"{repo}#{numero}")
    sair(i) if i else erro(f"GraphQL: Could not resolve to an issue or pull request with the number of {numero}.")
erro("gh da amostra: esta bancada não escreve no GitHub (" + comando + ")")
