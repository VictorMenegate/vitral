{
  "name": "vitral-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Os componentes do Vitral recriados em React, para o Claude Design. O app é Rust + GPUI; isto é a cópia fiel para desenhar telas.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitral-ui.css": "./dist/vitral-ui.css",
    "./tokens.css": "./tokens/tokens.css"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "vitral-ui-tokens": "file:./tokens"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "esbuild": "0.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
