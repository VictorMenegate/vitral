chamadas = []


def chamar(nome, argumentos):
    n = len(chamadas) + 1
    id_ = f"toolu_falso_{n}"
    emitir({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": id_, "name": f"mcp__vitral__{nome}", "input": argumentos}]}})
    corpo = json.dumps({"jsonrpc": "2.0", "id": n, "method": "tools/call",
                        "params": {"name": nome, "arguments": argumentos}}).encode()
    try:
        req = urllib.request.Request(url, data=corpo, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=300) as r:
            resposta = json.loads(r.read())["result"]
        resultado, erro = resposta["content"][0]["text"], bool(resposta.get("isError"))
    except Exception as e:  # noqa: BLE001 (a bancada só anota)
        resultado, erro = f"(claude falso) a chamada falhou: {e}", True
    emitir({"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": id_, "content": resultado, "is_error": erro}]}})
    chamadas.append({"nome": nome, "erro": erro, "resultado": resultado[:300]})
    return resultado, erro


def png_de_mentira(largura, altura, semente):
    """Um PNG de verdade (RGB, sem biblioteca): faixas na cor da semente, com uma barra de título
    escura e um quadro claro no meio, para a miniatura ter o que mostrar."""
    import struct
    import zlib

    def bloco(tipo, dados):
        return struct.pack(">I", len(dados)) + tipo + dados + struct.pack(">I", zlib.crc32(tipo + dados) & 0xFFFFFFFF)

    cor = [(semente * 53 + 40) % 200 + 30, (semente * 97 + 90) % 200 + 30, (semente * 31 + 150) % 200 + 30]
    linhas = bytearray()
    for y in range(altura):
        if y < altura // 12:
            pixel = bytes((28, 30, 36))
        else:
            claro = 235 - (y * 60 // max(altura, 1))
            pixel = bytes((claro, claro, claro))
        linha = bytearray(pixel * largura)
        # O quadro colorido no meio, com um degradê de lado a lado.
        if altura // 4 <= y < altura * 3 // 4:
            inicio, fim = largura // 6, largura * 5 // 6
            for x in range(inicio, fim):
                t = (x - inicio) * 255 // max(fim - inicio, 1)
                linha[x * 3:x * 3 + 3] = bytes((cor[0] * (255 - t) // 255 + t * 20 // 255, cor[1], (cor[2] + t) % 256))
        linhas += b"\x00" + linha
    return (b"\x89PNG\r\n\x1a\n" + bloco(b"IHDR", struct.pack(">IIBBBBB", largura, altura, 8, 2, 0, 0, 0))
            + bloco(b"IDAT", zlib.compress(bytes(linhas), 6)) + bloco(b"IEND", b""))


def bloco_de_imagem(dados, tipo="image/png"):
    import base64
    return {"type": "image", "source": {"type": "base64", "media_type": tipo, "data": base64.b64encode(dados).decode()}}


def medidas_do_print(detalhe):
    """`1280x800 inicio` -> (1280, 800, "inicio"); sem medidas, 1280x800."""
    achado = re.match(r"\s*(\d{1,4})x(\d{1,4})\s*(.*)$", detalhe)
    if achado:
        return max(int(achado.group(1)), 1), max(int(achado.group(2)), 1), achado.group(3).strip()
    return 1280, 800, detalhe.strip()


TIPOS_DE_IMAGEM = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}


def imagem_lida(caminho):
    """O bloco de imagem que o Read de verdade devolve para um arquivo de imagem que existe."""
    tipo = TIPOS_DE_IMAGEM.get(os.path.splitext(caminho)[1].lower())
    if not tipo:
        return None
    try:
        with open(os.path.expanduser(caminho), "rb") as arquivo:
            return bloco_de_imagem(arquivo.read(), tipo)
    except OSError:
        return None


# O começo do id das chamadas deste processo: como no de verdade, o id de uma chamada não se repete
# de um turno para o outro (é por ele que o Vitral acha o subagente de um cartão).
ID_DAS_CHAMADAS = f"toolu_falso_{int(time.time() * 10) & 0xfffff:05x}_"

# `[ferramenta Nome detalhe]` ou `[ferramenta Nome detalhe | 8]` (segundos até o resultado).
FERRAMENTA = re.compile(r"\[ferramenta ([A-Za-z]+) ([^\]|]+?)(?:\s*\|\s*(\d+))?\]")


DEZ_LINHAS = """def total(carrinho, cupom):
    subtotal = sum(i.preco for i in carrinho)
    if cupom is None:
        return subtotal
    desconto = aplicar_cupom(cupom, subtotal)
    total = subtotal - desconto
    if total < 0:
        total = 0
    registrar(total)
    return total"""

PASSOS_DE_MENTIRA = [
    ("Ler o código do cupom", "Lendo o código do cupom"),
    ("Corrigir o desconto", "Corrigindo o desconto"),
    ("Rodar os testes", "Rodando os testes"),
    ("Conferir o total negativo", "Conferindo o total negativo"),
    ("Escrever o relatório", "Escrevendo o relatório"),
    ("Atualizar a documentação", "Atualizando a documentação"),
]


def resultado_da_tarefa(nome, entrada):
    """O resultado de uma ferramenta de tarefas, como o Claude Code 2.1.328 o manda (medido em
    23/11/2026, no `-p` com CLAUDE_CODE_ENABLE_TODO_TOOLS=1): o texto e o `tool_use_result`. A
    lista fica por sessão, como a de verdade (que mora em `tasks/<sessão>/<id>.json` na pasta de
    configuração e continua de um turno para o outro)."""
    arquivo = os.path.join(estado, "claude-falso-tarefas-" + re.sub(r"[^A-Za-z0-9-]", "", sessao) + ".json")
    try:
        with open(arquivo) as guardadas:
            tarefas = json.load(guardadas)
    except (OSError, ValueError):
        tarefas = {"proxima": 1, "lista": []}
    achar = lambda id_: next((t for t in tarefas["lista"] if t["id"] == id_), None)  # noqa: E731
    if nome == "TaskCreate":
        tarefa = {"id": str(tarefas["proxima"]), "subject": entrada["subject"], "description": entrada["description"],
                  "activeForm": entrada.get("activeForm"), "status": "pending"}
        tarefas["proxima"] += 1
        tarefas["lista"].append(tarefa)
        texto_ = f"Task #{tarefa['id']} created successfully: {tarefa['subject']}"
        estruturado = {"task": {"id": tarefa["id"], "subject": tarefa["subject"], "description": tarefa["description"]}}
    elif nome == "TaskUpdate":
        tarefa = achar(entrada["taskId"])
        if tarefa is None:
            return "Task not found", {"success": False, "taskId": entrada["taskId"], "updatedFields": [], "error": "Task not found"}
        de, para = tarefa["status"], entrada["status"]
        tarefa["status"] = para
        if para == "deleted":
            tarefas["lista"].remove(tarefa)
        texto_ = f"Updated task #{tarefa['id']} {'deleted' if para == 'deleted' else 'status'}"
        estruturado = {"success": True, "taskId": tarefa["id"], "updatedFields": ["deleted" if para == "deleted" else "status"],
                       "statusChange": {"from": de, "to": para}}
    else:
        texto_ = "\n".join(f"#{t['id']} [{t['status']}] {t['subject']}" for t in tarefas["lista"]) or "No tasks found"
        estruturado = {"tasks": [{"id": t["id"], "subject": t["subject"], "status": t["status"], "blockedBy": []} for t in tarefas["lista"]]}
    try:
        with open(arquivo, "w") as guardadas:
            json.dump(tarefas, guardadas)
        if os.environ.get("CLAUDE_CONFIG_DIR"):
            pasta = os.path.join(os.environ["CLAUDE_CONFIG_DIR"], "tasks", sessao)
            os.makedirs(pasta, exist_ok=True)
            for antigo in os.listdir(pasta):
                if antigo.endswith(".json"):
                    os.remove(os.path.join(pasta, antigo))
            for t in tarefas["lista"]:
                with open(os.path.join(pasta, t["id"] + ".json"), "w") as saida:
                    json.dump({**{k: v for k, v in t.items() if v is not None}, "blocks": [], "blockedBy": []}, saida, indent=2)
    except OSError:
        pass
    return texto_, estruturado


def entrada_da_ferramenta(nome, detalhe):
    """O campo que o Vitral lê para montar o resumo de cada ferramenta."""
    # O Edit e o Write levam o que mudou: é o que a conversa mostra ao abrir a linha.
    # `[ferramenta EditGrande carrinho.py]`: um Edit de 30 linhas (24 entram e 6 saem), para o turno
    # passar das 20 linhas que disparam a revisão pelo outro agente.
    if nome == "EditGrande":
        return {"file_path": detalhe,
                "old_string": "\n".join(f"    linha_antiga_{n} = {n}" for n in range(6)),
                "new_string": "\n".join(f"    linha_nova_{n} = aplicar_cupom(cupom, {n})" for n in range(24))}
    if nome == "Edit":
        caminho = detalhe.replace("(palavra)", "").replace("(pede)", "").strip()
        # "(palavra)": uma palavra trocada num trecho de 10 linhas.
        if "(palavra)" in detalhe:
            return {"file_path": caminho, "old_string": DEZ_LINHAS,
                    "new_string": DEZ_LINHAS.replace("subtotal - desconto", "subtotal - abatimento")}
        return {"file_path": caminho,
                "old_string": "    total = subtotal\n    return total",
                "new_string": "    desconto = aplicar_cupom(cupom, subtotal)\n    total = subtotal - desconto\n    return total"}
    if nome == "Write":
        return {"file_path": detalhe, "content": "# criado pelo claude falso\nprint('ola')\n"}
    if nome in ("Read", "NotebookEdit"):
        return {"file_path": detalhe}
    if nome in ("Bash", "BashOutput"):
        return {"command": detalhe}
    if nome in ("Grep", "Glob"):
        return {"pattern": detalhe}
    if nome == "WebFetch":
        return {"url": detalhe}
    if nome == "WebSearch":
        return {"query": detalhe}
    if nome == "Agent":
        # As marcas do agente em segundo plano não fazem parte da descrição.
        return {"description": re.sub(r"\s*\((?:segue|falha)\)", "", detalhe).strip(), "run_in_background": True}
    if nome in ("Task", "Workflow"):
        return {"description": detalhe}
    if nome == "TodoWrite" and re.fullmatch(r"[fap]+", detalhe):
        # Um passo por letra: f feito, a em andamento, p pendente.
        estados = {"f": "completed", "a": "in_progress", "p": "pending"}
        return {"todos": [{"content": conteudo, "activeForm": fazendo, "status": estados[letra]}
                          for letra, (conteudo, fazendo) in zip(detalhe, PASSOS_DE_MENTIRA)]}
    if nome == "TaskCreate":
        assunto, _, fazendo = (parte.strip() for parte in detalhe.partition("=>"))
        return {"subject": assunto, "description": assunto, **({"activeForm": fazendo} if fazendo else {})}
    if nome == "TaskUpdate":
        id_, _, estado_novo = detalhe.partition(" ")
        return {"taskId": id_, "status": estado_novo.strip() or "completed"}
    if nome == "TaskList":
        return {}
    if nome == "TodoWrite":
        return {"todos": [
            {"content": "Ler o código do cupom", "activeForm": "Lendo o código do cupom", "status": "completed"},
            {"content": "Corrigir o desconto", "activeForm": "Corrigindo o desconto", "status": "in_progress"},
            {"content": "Rodar os testes", "activeForm": "Rodando os testes", "status": "pending"}]}
    return {"detalhe": detalhe}


def esperar_a_ferramenta(id_, nome, segundos):
    """A espera entre o tool_use e o tool_result. Enquanto ela dura, a mensagem que chega fica na
    fila, e a cada 30 s (CLAUDE_FALSO_BATIDA) sai o `tool_progress` com `heartbeat`, como no de
    verdade (2.1.328), preso à chamada pelo `parent_tool_use_id`."""
    batida = float(os.environ.get("CLAUDE_FALSO_BATIDA", "30") or 30)
    ferramenta_rodando.set()
    fim, n = time.time() + segundos, 0
    while True:
        falta = fim - time.time()
        if falta <= 0:
            break
        time.sleep(min(batida, falta))
        if fim - time.time() > 0:
            emitir({"type": "tool_progress", "tool_use_id": f"{id_}-heartbeat-{n}", "tool_name": nome,
                    "parent_tool_use_id": id_, "elapsed_time_seconds": int(batida * (n + 1)), "heartbeat": True,
                    "session_id": sessao})
            n += 1
    ferramenta_rodando.clear()


def arquivo_da_diretiva(nome, texto):
    """`[responde resposta.md]` e `[saida erro.txt]`: o conteúdo do arquivo citado (na pasta do
    chat), ou None sem a diretiva ou sem o arquivo."""
    achado = re.search(r"\[" + nome + r" ([^\]\s]+)\]", texto)
    if not achado:
        return None
    try:
        with open(achado.group(1)) as citado:
            return citado.read().rstrip("\n")
    except OSError:
        return None


def avisar_do_fundo():
    """O `background_tasks_changed` com tudo o que roda no fundo agora: os comandos e os
    subagentes que foram para o segundo plano (como no de verdade, a lista vem sempre inteira)."""
    with trava_do_fundo:
        tarefas = [{"task_id": id_, "task_type": "local_bash", "description": descricao}
                   for id_, (descricao, _) in comandos_de_fundo.items()]
        tarefas += [{"task_id": id_, "task_type": "local_agent", "description": descricao}
                    for id_, descricao in agentes_de_fundo.items()]
    emitir({"type": "system", "subtype": "background_tasks_changed", "tasks": tarefas})


def comando_de_fundo(id_, chamada, descricao, segundos):
    """Um comando de fundo, na thread dele: roda os segundos pedidos (ou até o `stop_task` dele),
    avisa que terminou e sai da lista."""
    parada = threading.Event()
    with trava_do_fundo:
        comandos_de_fundo[id_] = (descricao, parada)
    avisar_do_fundo()

    def rodar():
        parou = parada.wait(segundos)
        with trava_do_fundo:
            comandos_de_fundo.pop(id_, None)
        emitir({"type": "system", "subtype": "task_notification", "task_id": id_, "tool_use_id": chamada,
                "status": "killed" if parou else "completed", "summary": f"Background command \"{descricao}\""})
        avisar_do_fundo()

    thread = threading.Thread(target=rodar, daemon=True)
    thread.start()
    return thread


def nome_do_projeto(caminho):
    """A pasta do projeto em `projects`, como o Claude Code a monta: o que não é letra ou número
    vira `-` (os caminhos da bancada não passam de 200 caracteres, onde ele corta)."""
    return re.sub(r"[^A-Za-z0-9]", "-", caminho)


def permissao_do_vitral(chamada, nome, entrada):
    """O pedido de permissão de uma chamada, como o Claude Code faz ao `--permission-prompt-tool`:
    espera a resposta do usuário e diz se ele deixou. Sem a ferramenta de permissão (o modo "sem
    perguntar"), deixa."""
    if "--permission-prompt-tool" not in args or not url:
        return True
    corpo = json.dumps({"jsonrpc": "2.0", "id": 9000, "method": "tools/call", "params": {
        "name": "permissao", "arguments": {"tool_name": nome, "input": entrada, "tool_use_id": chamada}}}).encode()
    try:
        req = urllib.request.Request(url, data=corpo, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=3600) as r:
            resposta = json.loads(json.loads(r.read())["result"]["content"][0]["text"])
        return resposta.get("behavior") == "allow"
    except Exception as e:  # noqa: BLE001 (a bancada só anota)
        anotar({"permissao_falhou": str(e)})
        return False


class Subagente:
    """Um subagente de mentira, como o Claude Code 2.1.328 o mostra (medido em 23/11/2026): o
    `task_started`, o pedido como mensagem do usuário presa à chamada (`parent_tool_use_id` e
    `agent_id`), cada chamada dele e o resultado dela no stream, e o texto e o raciocínio só no
    arquivo (no stream, só com `--forward-subagent-text`). O arquivo é o de verdade: com um
    CLAUDE_CONFIG_DIR de mentira, `projects/<pasta>/<sessão>/subagents/agent-<id>.jsonl`, gravado
    aos poucos, e o `agent-<id>.meta.json` com a chamada que o abriu (`toolUseId`)."""

    def __init__(self, pai, descricao, fundo=False):
        self.pai, self.descricao, self.fundo = pai, descricao, fundo
        self.agente = "a" + hashlib.md5(f"{sessao}{pai}".encode()).hexdigest()[:16]
        self.usadas, self.anterior, self.arquivo, self.meta = 0, None, None, None
        self.comeco, self.comecou = time.time(), False
        if config:
            pasta = os.path.join(config, "projects", nome_do_projeto(os.getcwd()), sessao, "subagents")
            os.makedirs(pasta, exist_ok=True)
            self.arquivo = os.path.join(pasta, f"agent-{self.agente}.jsonl")
            self.meta = os.path.join(pasta, f"agent-{self.agente}.meta.json")
            self.gravar_meta(False)

    def gravar_meta(self, terminou):
        """O `agent-<id>.meta.json`, com os campos do de verdade (2.1.328): a descrição, a chamada
        que o abriu, o modelo e, no fim, o `finished`."""
        if not self.meta:
            return
        dados = {"agentType": "general-purpose", "isBuiltIn": True, "description": self.descricao,
                 "toolUseId": self.pai, "spawnDepth": 1, "model": "claude-falso"}
        if self.fundo:
            dados["requestShape"] = "background"
        if terminou:
            dados["finished"] = True
        with open(self.meta, "w") as meta:
            json.dump(dados, meta, ensure_ascii=False)

    def gravar_pedido_a_api(self):
        """Entre o resultado de uma chamada e a chamada seguinte, o de verdade grava as linhas do
        pedido à API (`api-request-blob`, `api-request`): o fim do arquivo nem sempre é uma chamada."""
        if not self.arquivo:
            return
        agora_ = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
        with open(self.arquivo, "a") as saida:
            saida.write(json.dumps({"type": "api-request-blob", "sessionId": sessao, "agentId": self.agente,
                                    "hash": uuid.uuid4().hex[:12], "content": [{"type": "text", "text": "…"}]}) + "\n")
            saida.write(json.dumps({"type": "api-request", "sessionId": sessao, "agentId": self.agente,
                                    "id": uuid.uuid4().hex[:12], "timestamp": agora_}) + "\n")

    def gravar(self, tipo, mensagem):
        if not self.arquivo:
            return
        linha = {"parentUuid": self.anterior, "isSidechain": True, "agentId": self.agente, "type": tipo,
                 "uuid": str(uuid.uuid4()),
                 "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
                 "sessionId": sessao, "cwd": os.getcwd(), "version": "2.1.328", "message": mensagem}
        self.anterior = linha["uuid"]
        with open(self.arquivo, "a") as saida:
            saida.write(json.dumps(linha, ensure_ascii=False) + "\n")

    def no_stream(self, tipo, conteudo):
        emitir({"type": tipo, "parent_tool_use_id": self.pai, "agent_id": self.agente, "message": {"content": conteudo}})

    def pedido(self):
        return f"{self.descricao}.\n\nProcure onde o cupom é aplicado, confira os testes e responda em duas frases."

    def comecar(self, pedido):
        self.comecou = True
        emitir({"type": "system", "subtype": "task_started", "task_id": self.agente, "tool_use_id": self.pai,
                "description": self.descricao, "subagent_type": "general-purpose", "is_backgrounded": self.fundo,
                "task_type": "local_agent", "prompt": pedido})
        self.gravar("user", {"role": "user", "content": pedido})
        self.no_stream("user", [{"type": "text", "text": pedido}])

    def falar(self, bloco):
        """Um texto ou um raciocínio: sempre no arquivo; no stream, só com a opção de repassar."""
        self.gravar("assistant", {"id": "msg_" + uuid.uuid4().hex[:12], "role": "assistant", "content": [bloco]})
        if "--forward-subagent-text" in args:
            self.no_stream("assistant", [bloco])

    def usar(self, id_, nome, entrada, resultado, espera, pede=False):
        """Uma chamada do subagente: o tool_use, a espera (e, com `pede`, a permissão do usuário
        antes dela) e o tool_result."""
        bloco = {"type": "tool_use", "id": id_, "name": nome, "input": entrada}
        self.gravar("assistant", {"id": "msg_" + uuid.uuid4().hex[:12], "role": "assistant", "content": [bloco]})
        # O progresso vem antes da chamada, como no de verdade; a entrega do relatório não conta.
        if nome != "SubagentHandback":
            self.usadas += 1
            emitir({"type": "system", "subtype": "task_progress", "task_id": self.agente, "tool_use_id": self.pai,
                    "description": "Running " + nome, "usage": {"tool_uses": self.usadas, "total_tokens": 35000 + 900 * self.usadas}})
        self.no_stream("assistant", [bloco])
        erro = False
        if pede and not permissao_do_vitral(id_, nome, entrada):
            resultado, erro = "The user doesn't want to proceed with this tool use.", True
        else:
            time.sleep(espera)
        retorno = {"tool_use_id": id_, "type": "tool_result", "content": resultado, "is_error": erro}
        self.gravar("user", {"role": "user", "content": [retorno]})
        self.gravar_pedido_a_api()
        self.no_stream("user", [retorno])

    def trabalhar(self, espera):
        """O que todo subagente de mentira faz: pensa, procura, lê, diz uma frase, roda os testes
        e responde. Com "(pede)" na descrição, o comando dele pede permissão; com "(entrega)", o
        relatório vai pela chamada SubagentHandback, como no modo automático. Devolve o relatório."""
        pai = self.pai
        if not self.comecou:
            self.comecar(self.pedido())
        self.falar({"type": "thinking", "thinking": "Preciso achar onde o cupom entra no total antes de olhar os testes."})
        time.sleep(espera)
        self.usar(pai + "a", "Grep", {"pattern": "cupom"},
                  "produtos/views.py:42:    desconto = aplicar_cupom(cupom, subtotal)\nprodutos/tests.py:17:def test_cupom_percentual():", espera)
        self.usar(pai + "b", "Read", {"file_path": "produtos/views.py"},
                  "40\tdef total(carrinho, cupom):\n41\t    subtotal = sum(i.preco for i in carrinho)\n"
                  "42\t    desconto = aplicar_cupom(cupom, subtotal)\n43\t    return subtotal - desconto", espera)
        self.falar({"type": "text", "text": "Conferindo os testes do carrinho."})
        self.usar(pai + "c", "Bash", {"command": "python3 manage.py test", "description": "Rodar os testes"},
                  "Ran 12 tests in 0.8s\n\nOK", espera, pede="(pede)" in self.descricao)
        relatorio = f"(claude falso) {self.descricao}: dois lugares mexem no cupom.\n\nOs 12 testes passam."
        if "(entrega)" in self.descricao:
            self.usar(pai + "d", "SubagentHandback", {"message": relatorio},
                      [{"type": "text", "text": "{\"success\":true,\"message\":\"Report delivered to your caller.\"}"}], 0)
        else:
            self.falar({"type": "text", "text": relatorio})
        return relatorio

    def resultado(self, relatorio):
        """O que a chamada que o abriu recebe: o relatório dentro da moldura do Claude Code ou, com
        "(entrega)", só o aviso de que ele foi entregue."""
        if "(entrega)" in self.descricao:
            corpo = (f"  This agent's report was delivered to you as a message from \"{self.agente}\" (its SubagentHandback "
                     "call). Read it there; it is not repeated here.\n  ")
        else:
            corpo = ("  <tools-used-before-summary>Grep, Read, Bash</tools-used-before-summary>\n  \n[Subagent hand-back] The text "
                     "below is the final report of a subagent this session delegated to. The report follows:\n"
                     + "\n".join("  " + l for l in relatorio.splitlines()))
        return (f"{corpo}\nagentId: {self.agente} (use SendMessage with to: '{self.agente}' to continue this agent)\n"
                f"<usage>subagent_tokens: {35000 + 900 * self.usadas}\ntool_uses: {self.usadas}\n"
                f"duration_ms: {int((time.time() - self.comeco) * 1000)}</usage>")

    def terminar(self, relatorio):
        """O fim do subagente que a conversa esperou: o aviso de fim e o resultado da chamada."""
        resumo = relatorio
        if "(entrega)" in self.descricao:
            resumo = f"This agent's report was delivered to you as a message from \"{self.agente}\" (its SubagentHandback call)."
        emitir({"type": "system", "subtype": "task_notification", "task_id": self.agente, "tool_use_id": self.pai,
                "status": "completed", "summary": resumo,
                "usage": {"tool_uses": self.usadas, "total_tokens": 35000 + 900 * self.usadas}})
        emitir({"type": "user", "message": {"content": [{"tool_use_id": self.pai, "type": "tool_result",
                "content": [{"type": "text", "text": self.resultado(relatorio)}]}]},
                "tool_use_result": {"status": "completed", "agentId": self.agente, "agentType": "general-purpose"}})


# Os agentes que seguem trabalhando depois do `result` (`[ferramenta Agent <tarefa> (segue) | 40]`):
# quantos foram lançados e, na ordem em que acabam, cada um que terminou.
agentes_que_seguem = []
agentes_terminados = queue.Queue()


def agente_em_segundo_plano(sub, espera, falha=False):
    """O agente que foi para o segundo plano trabalha e avisa o fim como o de verdade (2.1.328,
    medido em 23/11/2026): o `task_updated`, o `task_notification` com o relatório no `summary` e a
    lista do fundo sem ele. Com `falha`, o aviso vem `failed` (a frase do erro é inventada: a falha
    de um agente de verdade não foi medida)."""
    relatorio = sub.trabalhar(espera)
    if falha:
        relatorio = "(claude falso) O agente parou no meio: a API não respondeu a tempo."
    sub.gravar_meta(True)
    estado_final = "failed" if falha else "completed"
    emitir({"type": "system", "subtype": "task_updated", "task_id": sub.agente,
            "patch": {"status": estado_final, "end_time": int(time.time() * 1000)}})
    emitir({"type": "system", "subtype": "task_notification", "task_id": sub.agente, "tool_use_id": sub.pai,
            "status": estado_final, "summary": relatorio, "summary_is_report": not falha,
            "usage": {"tool_uses": sub.usadas, "total_tokens": 35000 + 900 * sub.usadas,
                      "duration_ms": int((time.time() - sub.comeco) * 1000)}})
    with trava_do_fundo:
        agentes_de_fundo.pop(sub.agente, None)
    avisar_do_fundo()
    agentes_terminados.put(sub)


def fingir_ferramentas(texto):
    """Faz de conta que usa cada ferramenta pedida, uma de cada vez, com a espera entre o
    tool_use e o tool_result: é nessa janela que a conversa mostra o que ele está fazendo."""
    global tempo_das_ferramentas, idas_ao_modelo
    pedidas = FERRAMENTA.findall(texto)
    # `[juntas]` só com subagentes: as chamadas Task saem numa resposta só e os subagentes
    # trabalham ao mesmo tempo, cada um terminando quando o dele acaba.
    if "[juntas]" in texto and pedidas and all(nome == "Task" for nome, _, _ in pedidas):
        antes = time.time()
        idas_ao_modelo += 1
        emitir({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": f"{ID_DAS_CHAMADAS}f{i}", "name": "Task", "input": entrada_da_ferramenta("Task", detalhe.strip())}
            for i, (_, detalhe, _) in enumerate(pedidas, start=1)]}})

        def um(i, detalhe, segundos):
            sub = Subagente(f"{ID_DAS_CHAMADAS}f{i}", detalhe)
            sub.terminar(sub.trabalhar((int(segundos) if segundos else 8) / 4))

        juntos = [threading.Thread(target=um, args=(i, detalhe.strip(), segundos), daemon=True)
                  for i, (_, detalhe, segundos) in enumerate(pedidas, start=1)]
        for thread in juntos:
            thread.start()
            time.sleep(0.2)
        for thread in juntos:
            thread.join()
        tempo_das_ferramentas += time.time() - antes
        return
    de_fundo = []
    # `[juntas]`: as chamadas comuns saem numa resposta só e cada resultado chega quando a dela
    # termina (a mais rápida primeiro), como as chamadas em paralelo do de verdade.
    especiais = ("Pensa", "Fundo", "Agent", "Task", "Estourou")
    if "[juntas]" in texto and pedidas and not any(nome in especiais for nome, _, _ in pedidas):
        # O que ele diz no meio do turno vem antes das chamadas.
        for _, detalhe, _ in (p for p in pedidas if p[0] == "Diz"):
            emitir({"type": "assistant", "message": {"content": [{"type": "text", "text": detalhe.strip()}]}})
        pedidas = [p for p in pedidas if p[0] != "Diz"]
        antes = time.time()
        idas_ao_modelo += 1
        emitir({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": f"{ID_DAS_CHAMADAS}f{i}", "name": nome, "input": entrada_da_ferramenta(nome, detalhe.strip())}
            for i, (nome, detalhe, _) in enumerate(pedidas, start=1)]}})
        passou = 0
        for segundos, i, nome, detalhe in sorted((int(s) if s else 4, i, n, d.strip()) for i, (n, d, s) in enumerate(pedidas, start=1)):
            time.sleep(max(0, segundos - passou))
            passou = max(passou, segundos)
            emitir({"type": "user", "message": {"content": [
                {"type": "tool_result", "tool_use_id": f"{ID_DAS_CHAMADAS}f{i}", "content": f"(claude falso) {nome} em {detalhe}"}]}})
        tempo_das_ferramentas += time.time() - antes
        return
    saida_do_arquivo = arquivo_da_diretiva("saida", texto)
    for i, (nome, detalhe, segundos) in enumerate(pedidas, start=1):
        detalhe = detalhe.strip()
        id_ = f"{ID_DAS_CHAMADAS}f{i}"
        # `[ferramenta Pensa texto | 2]` não é ferramenta: é um bloco de raciocínio, que começa
        # (o evento parcial), dura os segundos pedidos e chega inteiro na mensagem.
        if nome == "Pensa":
            emitir({"type": "stream_event", "event": {"type": "content_block_start", "content_block": {"type": "thinking"}}})
            time.sleep(int(segundos) if segundos else 2)
            # Como o de verdade (2.1.328): o texto só vem com `--thinking-display summarized`.
            resumido = valor_de("--thinking-display") == "summarized"
            emitir({"type": "assistant", "message": {"content": [
                {"type": "thinking", "thinking": detalhe if resumido else "", "signature": "falsa"}]}})
            continue
        # `[ferramenta Diz Vou olhar o carrinho.]`: um texto no meio do turno, entre as chamadas. É
        # ele que faz o turno pronto recolher na linha "Trabalhou…".
        if nome == "Diz":
            emitir({"type": "assistant", "message": {"content": [{"type": "text", "text": detalhe}]}})
            continue
        # `[ferramenta AgenteFundo confere os testes | 30]`: um Agent com run_in_background que
        # segue trabalhando DEPOIS do `result` do turno (os segundos pedidos), como no de verdade
        # (2.1.328): a chamada volta na hora, o turno termina e o processo fica esperando por ele.
        if nome == "AgenteFundo":
            tarefa = f"falso{os.getpid()}x{i}"
            emitir({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": id_, "name": "Agent",
                    "input": {"description": detalhe, "prompt": detalhe, "subagent_type": "general-purpose",
                              "run_in_background": True}}]}})
            with trava_dos_agentes:
                agentes_de_fundo[tarefa] = detalhe
            emitir({"type": "system", "subtype": "background_tasks_changed", "tasks": tarefas_de_fundo()})
            emitir({"type": "system", "subtype": "task_started", "task_id": tarefa, "tool_use_id": id_,
                    "task_type": "local_agent", "description": detalhe})
            emitir({"type": "user", "message": {"content": [{"tool_use_id": id_, "type": "tool_result",
                    "content": [{"type": "text", "text": "Async agent launched successfully."}]}]},
                    "tool_use_result": {"isAsync": True, "status": "async_launched", "agentId": tarefa}})
            threading.Thread(target=agente_de_fundo, args=(tarefa, id_, detalhe, int(segundos) if segundos else 30),
                             daemon=True).start()
            continue
        # `[ferramenta Fundo npm run dev | 20]`: um Bash com run_in_background, como o de verdade
        # (2.1.325): volta na hora, a tarefa aparece em background_tasks_changed e some quando acaba
        # (ou quando o Vitral manda o stop_task).
        if nome == "Fundo":
            emitir({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": id_, "name": "Bash",
                    "input": {"command": detalhe, "run_in_background": True, "description": detalhe}}]}})
            emitir({"type": "user", "message": {"content": [{"tool_use_id": id_, "type": "tool_result",
                    "content": f"Command running in background with ID: bfalso{i}."}]},
                    "tool_use_result": {"stdout": "", "stderr": "", "interrupted": False, "backgroundTaskId": f"bfalso{i}"}})
            de_fundo.append(comando_de_fundo(f"bfalso{i}", id_, detalhe, int(segundos) if segundos else 20))
            continue
        idas_ao_modelo += 1
        # `[ferramenta Estourou npm run dev | 12]`: o Bash que passou do tempo dele. Como no de
        # verdade (2.1.328), o resultado chega nessa hora dizendo que o comando foi para o segundo
        # plano, com o `backgroundTaskId` e o `timedOutAfterMs`, e o comando segue rodando.
        if nome == "Estourou":
            espera = int(segundos) if segundos else 12
            emitir({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": id_, "name": "Bash",
                    "input": {"command": detalhe, "timeout": espera * 1000}}]}})
            time.sleep(espera)
            tempo_das_ferramentas += espera
            emitir({"type": "system", "subtype": "background_tasks_changed",
                    "tasks": [{"task_id": f"bfalso{i}", "task_type": "local_bash", "description": detalhe}]})
            emitir({"type": "user", "message": {"content": [{"tool_use_id": id_, "type": "tool_result",
                    "content": f"Command did not complete within its {espera}s timeout and was moved to the background (ID: bfalso{i})."}]},
                    "tool_use_result": {"stdout": "", "stderr": "", "interrupted": False, "backgroundTaskId": f"bfalso{i}",
                                        "timedOutAfterMs": espera * 1000}})
            antes = time.time()
            tarefa_parada.wait(4)
            tempo_das_ferramentas += time.time() - antes
            emitir({"type": "system", "subtype": "background_tasks_changed", "tasks": []})
            continue
        # `[ferramenta Falha cargo test]`: o Bash que saiu com erro, como o de verdade (o `is_error`
        # e o "Exit code" na frente da saída). É com ele que a linha "Trabalhou…" mostra a
        # checagem que falhou.
        if nome == "Falha":
            emitir({"type": "assistant", "message": {"content": [
                {"type": "tool_use", "id": id_, "name": "Bash", "input": {"command": detalhe}}]}})
            time.sleep(int(segundos) if segundos else 2)
            tempo_das_ferramentas += int(segundos) if segundos else 2
            emitir({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": id_, "is_error": True,
                    "content": f"Exit code 101\n(claude falso) {detalhe} falhou"}]}})
            continue
        # `[ferramenta Print 1280x800 inicio]`: o print de um MCP de navegador, com o texto e a
        # imagem em base64 no mesmo tool_result (`Prints` devolve duas imagens).
        if nome in ("Print", "Prints"):
            largura, altura, rotulo = medidas_do_print(detalhe)
            semente = sum(rotulo.encode()) + i
            ferramenta_rodando.set()
            emitir({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": id_,
                    "name": "mcp__chrome-devtools__take_screenshot", "input": {"format": "png"}}]}})
            esperar_a_ferramenta(id_, "mcp__chrome-devtools__take_screenshot", int(segundos) if segundos else 2)
            imagens = [bloco_de_imagem(png_de_mentira(largura, altura, semente))]
            if nome == "Prints":
                imagens.append(bloco_de_imagem(png_de_mentira(max(largura // 2, 1), altura, semente + 7)))
            emitir({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": id_, "content": [
                {"type": "text", "text": "Took a screenshot of the current page's viewport."}] + imagens}]}})
            absorver_fila()
            continue
        # A chamada conta como rodando desde o tool_use: a mensagem que o Vitral manda ao vê-lo já
        # espera na fila (o subagente tem o caminho dele, abaixo).
        if nome not in ("Task", "Agent"):
            ferramenta_rodando.set()
        entrada = entrada_da_ferramenta(nome, detalhe)
        emitir({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": id_, "name": "Edit" if nome == "EditGrande" else nome, "input": entrada}]}})
        # As ferramentas de tarefas (TaskCreate, TaskUpdate, TaskList): rápidas, com o texto e o
        # `tool_use_result` do de verdade.
        if nome in ("TaskCreate", "TaskUpdate", "TaskList"):
            time.sleep(int(segundos) if segundos else 1)
            tempo_das_ferramentas += int(segundos) if segundos else 1
            texto_, estruturado = resultado_da_tarefa(nome, entrada)
            emitir({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": id_, "content": texto_}]},
                    "tool_use_result": estruturado})
            # A chamada voltou: a mensagem que esperava entra no turno (ver `esperar_a_ferramenta`).
            ferramenta_rodando.clear()
            absorver_fila()
            continue
        # `[ferramenta Edit a.py (pede)]`: a edição pede permissão ao Vitral antes, como no modo
        # manual (o cartão de permissão mostra o mesmo diff da trilha).
        if nome == "Edit" and "(pede)" in detalhe and not permissao_do_vitral(id_, nome, entrada):
            emitir({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": id_, "is_error": True,
                    "content": "The user doesn't want to proceed with this tool use."}]}})
            continue
        # O Agent vai para o segundo plano, como no Claude Code 2.1.3xx: a chamada volta na hora com
        # "Async agent launched", o progresso conta as ferramentas e o fim vem num aviso à parte.
        if nome == "Agent":
            sub = Subagente(id_, entrada["description"], fundo=True)
            # Na ordem do de verdade: a lista do fundo, o `task_started` e só então o resultado.
            with trava_do_fundo:
                agentes_de_fundo[sub.agente] = sub.descricao
            avisar_do_fundo()
            sub.comecar(sub.pedido())
            emitir({"type": "user", "message": {"content": [{"tool_use_id": id_, "type": "tool_result",
                    "content": [{"type": "text", "text": "Async agent launched successfully."}]}]},
                    "tool_use_result": {"isAsync": True, "status": "async_launched", "agentId": sub.agente}})
            espera, falha = (int(segundos) if segundos else 8) / 4, "(falha)" in detalhe
            # `(segue)`: ele continua depois do `result` deste turno, e o fim dele abre outro.
            if "(segue)" in detalhe:
                thread = threading.Thread(target=agente_em_segundo_plano, args=(sub, espera, falha), daemon=True)
                thread.start()
                agentes_que_seguem.append(thread)
                continue
            agente_em_segundo_plano(sub, espera, falha)
            agentes_terminados.get()
            continue
        # O subagente trabalha lá dentro (ver `Subagente`), e a conversa espera por ele.
        if nome == "Task":
            sub = Subagente(id_, detalhe)
            sub.terminar(sub.trabalhar((int(segundos) if segundos else 8) / 4))
            continue
        esperar_a_ferramenta(id_, nome, int(segundos) if segundos else 4)
        tempo_das_ferramentas += int(segundos) if segundos else 4
        # O Read de uma imagem que existe devolve só o bloco de imagem dela, como o de verdade.
        lida = imagem_lida(detalhe) if nome == "Read" else None
        resultado = saida_do_arquivo if saida_do_arquivo is not None else f"(claude falso) {nome} em {detalhe}"
        emitir({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": id_, "content": [lida] if lida else resultado}]}})
        absorver_fila()
    # Os comandos de fundo que ainda rodam seguram o turno até terminarem (ou até o Parar de cada
    # um): é a janela em que a pílula deles aparece.
    for thread in de_fundo:
        thread.join()


# `[hook Nome detalhe | motivo]`: a chamada que um hook PreToolUse mandou perguntar.
HOOK = re.compile(r"\[hook ([A-Za-z_]+) ([^\]|]+?)\s*\|\s*([^\]]+)\]")


def encenar_hooks(texto):
    """Cada `[hook ...]` vira o que o Claude Code 2.1.328 faz com o "ask" de um hook PreToolUse
    (medido em 23/11/2026): o tool_use; com `--include-hook-events`, o hook_started e o
    hook_response (o motivo só aparece aqui, na saída do hook, sem o id da chamada); e o pedido à
    ferramenta do `--permission-prompt-tool`, só com tool_name, input e tool_use_id. Sem essa
    ferramenta, ninguém é perguntado: a chamada volta recusada, com o motivo do hook como erro."""
    proprio = "\n".join(l for l in texto.splitlines() if not l.lstrip().startswith(">"))
    for i, (nome, detalhe, motivo) in enumerate(HOOK.findall(proprio), start=1):
        detalhe, motivo = detalhe.strip(), motivo.strip()
        id_ = f"toolu_falso_h{i}"
        entrada = entrada_da_ferramenta(nome, detalhe)
        emitir({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": id_, "name": nome, "input": entrada}]}})
        if "--include-hook-events" in args:
            saida = json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "ask",
                                                       "permissionDecisionReason": motivo}}, ensure_ascii=False) + "\n"
            base = {"type": "system", "hook_id": f"hook-falso-{i}", "hook_name": f"PreToolUse:{nome}",
                    "hook_event": "PreToolUse", "session_id": sessao}
            emitir({**base, "subtype": "hook_started"})
            emitir({**base, "subtype": "hook_response", "output": saida, "stdout": saida, "stderr": "",
                    "exit_code": 0, "outcome": "success"})
        if valor_de("--permission-prompt-tool") != "mcp__vitral__permissao" or not url:
            anotar({"hook": nome, "perguntou": False})
            emitir({"type": "user", "message": {"content": [
                {"type": "tool_result", "tool_use_id": id_, "content": motivo, "is_error": True}]}})
            continue
        argumentos = {"tool_name": nome, "input": entrada, "tool_use_id": id_}
        corpo = json.dumps({"jsonrpc": "2.0", "id": 9000 + i, "method": "tools/call",
                            "params": {"name": "permissao", "arguments": argumentos}}).encode()
        # Esperando a resposta, a chamada está em curso: a mensagem que chega fica na fila.
        ferramenta_rodando.set()
        try:
            req = urllib.request.Request(url, data=corpo, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=3600) as r:
                decisao = json.loads(json.loads(r.read())["result"]["content"][0]["text"])
        except Exception as e:  # noqa: BLE001 (a bancada só anota)
            decisao = {"behavior": "deny", "message": f"(claude falso) o pedido de permissão falhou: {e}"}
        permitiu = decisao.get("behavior") == "allow"
        anotar({"hook": nome, "perguntou": True, "permitiu": permitiu})
        if permitiu:
            time.sleep(1)
            resultado = f"(claude falso) {nome} em {detalhe}"
        else:
            resultado = decisao.get("message") or "negado"
        ferramenta_rodando.clear()
        emitir({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": id_, "content": resultado, "is_error": not permitiu}]}})
        absorver_fila()


def pedir_permissao(numero, nome, entrada, id_):
    """O pedido à ferramenta do `--permission-prompt-tool`, como o Claude Code o faz: só com
    tool_name, input e tool_use_id. Devolve a decisão, ou None sem a ferramenta nos argumentos."""
    if valor_de("--permission-prompt-tool") != "mcp__vitral__permissao" or not url:
        return None
    corpo = json.dumps({"jsonrpc": "2.0", "id": numero, "method": "tools/call",
                        "params": {"name": "permissao", "arguments": {"tool_name": nome, "input": entrada, "tool_use_id": id_}}}).encode()
    # Esperando a resposta, a chamada está em curso: a mensagem que chega fica na fila.
    ferramenta_rodando.set()
    try:
        req = urllib.request.Request(url, data=corpo, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=3600) as r:
            decisao = json.loads(json.loads(r.read())["result"]["content"][0]["text"])
    except Exception as e:  # noqa: BLE001 (a bancada só anota)
        decisao = {"behavior": "deny", "message": f"(claude falso) o pedido de permissão falhou: {e}"}
    ferramenta_rodando.clear()
    return decisao


# `[pergunta Cabeçalho | pergunta | opção: descrição; opção]`; com `+`, aceita várias.
PERGUNTA = re.compile(r"\[pergunta(\+?) ([^\]|]+?)\s*\|\s*([^\]|]+?)\s*\|\s*([^\]]+)\]")
# O que foi respondido, para o fim da resposta do turno.
respondidas = []


def encenar_perguntas(texto):
    """Todas as `[pergunta ...]` da mensagem viram uma AskUserQuestion só, como o modelo faz, e a
    volta é o que o Claude Code 2.1.328 diz ao modelo em cada caso (medido em 23/11/2026)."""
    proprio = "\n".join(l for l in texto.splitlines() if not l.lstrip().startswith(">"))
    perguntas = []
    for varias, cabecalho, pergunta, opcoes in PERGUNTA.findall(proprio):
        lidas = []
        for opcao in opcoes.split(";"):
            rotulo, _, descricao = opcao.strip().partition(": ")
            if rotulo.strip():
                lidas.append({"label": rotulo.strip(), "description": descricao.strip()})
        perguntas.append({"question": pergunta.strip(), "header": cabecalho.strip(), "options": lidas,
                          "multiSelect": bool(varias)})
    if not perguntas:
        return
    if valor_de("--permission-prompt-tool") != "mcp__vitral__permissao" or not url:
        # No de verdade, sem a ferramenta de permissão a AskUserQuestion nem aparece no `-p`.
        anotar({"pergunta": len(perguntas), "perguntou": False})
        respondidas.append("sem a ferramenta de permissão a AskUserQuestion não existe")
        return
    id_ = "toolu_falso_q1"
    entrada = {"questions": perguntas}
    emitir({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": id_, "name": "AskUserQuestion", "input": entrada}]}})
    decisao = pedir_permissao(9500, "AskUserQuestion", entrada, id_)
    erro = False
    if decisao.get("behavior") != "allow":
        resultado, erro = decisao.get("message") or "negado", True
    elif not isinstance((decisao.get("updatedInput") or {}).get("questions"), list):
        resultado, erro = ("<tool_use_error>The permission handler returned updatedInput for AskUserQuestion that failed "
                           "schema validation: AskUserQuestion failed due to the following issue:\nThe required parameter "
                           "`questions` is missing\nThis is a configuration issue in your canUseTool callback, "
                           "PermissionRequest hook, or permission-prompt tool — updatedInput must satisfy the tool's input "
                           "schema. The tool input from the model was valid.</tool_use_error>"), True
    else:
        respostas = decisao["updatedInput"].get("answers") or {}
        pares = ", ".join(f'"{p}"="{r}"' for p, r in respostas.items())
        rotulos = {o["label"] for p in perguntas for o in p["options"]}
        das_opcoes = all(parte.strip() in rotulos for r in respostas.values() for parte in str(r).split(","))
        if not respostas:
            resultado = "The user did not answer the questions."
        elif das_opcoes:
            resultado = f"Your questions have been answered: {pares}. You can now continue with these answers in mind."
        else:
            resultado = (f"The user answered: {pares}. Read the answers carefully — they may request clarification, "
                         "changes, or that you not proceed — and follow what they actually say.")
        respondidas.extend(f"{p} = {r}" for p, r in respostas.items())
    anotar({"pergunta": len(perguntas), "perguntou": True, "resultado": resultado[:300]})
    emitir({"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": id_, "content": resultado, "is_error": erro}]}})
    absorver_fila()


# `[plano texto]`: um `\n` escrito vira quebra de linha.
PLANO = re.compile(r"\[plano ([^\]]+)\]")


def encenar_planos(texto):
    """Cada `[plano ...]` vira o que o Claude Code 2.1.328 faz ao sair do modo de planejar: a
    chamada ExitPlanMode vazia, o pedido de permissão com o plano e, aprovado, o resultado com o
    plano depois de "## Approved Plan:"; recusado, a mensagem como erro."""
    proprio = "\n".join(l for l in texto.splitlines() if not l.lstrip().startswith(">"))
    for i, plano in enumerate(PLANO.findall(proprio), start=1):
        plano = plano.strip().replace("\\n", "\n")
        id_ = f"toolu_falso_p{i}"
        arquivo_do_plano = os.path.join(estado, f"plano-falso-{i}.md")
        emitir({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": id_, "name": "ExitPlanMode", "input": {}}]}})
        decisao = pedir_permissao(9700 + i, "ExitPlanMode", {"plan": plano, "planFilePath": arquivo_do_plano}, id_)
        if decisao is None:
            anotar({"plano": i, "perguntou": False})
            emitir({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": id_, "is_error": True,
                    "content": "(claude falso) sem a ferramenta de permissão não há a quem mostrar o plano"}]}})
            continue
        aprovado = decisao.get("behavior") == "allow"
        anotar({"plano": i, "perguntou": True, "aprovado": aprovado})
        if aprovado:
            final = (decisao.get("updatedInput") or {}).get("plan") or plano
            resultado = ("User has approved your plan. You can now start coding. Start with updating your todo list if "
                         f"applicable\n\nYour plan has been saved to: {arquivo_do_plano}\nYou can refer back to it if needed "
                         f"during implementation.\n\n## Approved Plan:\n{final}\n")
        else:
            resultado = decisao.get("message") or "negado"
        emitir({"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": id_, "content": resultado, "is_error": not aprovado}]}})
        absorver_fila()


# `[compacta auto 168432 | 4]`: o gatilho, os tokens de antes e os segundos, todos opcionais.
COMPACTA = re.compile(r"\[compacta(?: (auto|manual))?(?: (\d+))?(?:\s*\|\s*(\d+))?\]")


def encenar_compactacao(texto):
    proprio = "\n".join(l for l in texto.splitlines() if not l.lstrip().startswith(">"))
    for gatilho, antes, segundos in COMPACTA.findall(proprio):
        compactar(gatilho == "manual", int(antes) if antes else 168432, int(segundos) if segundos else 4)


def diretivas(texto):
    """Os `[mcp nome {json}]` do texto, fora das linhas citadas."""
    proprio = "\n".join(l for l in texto.splitlines() if not l.lstrip().startswith(">"))
    achadas = []
    decodificador = json.JSONDecoder()
    for m in re.finditer(r"\[mcp (\w+)", proprio):
        resto = proprio[m.end():].lstrip()
        argumentos = {}
        if resto.startswith("{"):
            try:
                argumentos, _ = decodificador.raw_decode(resto)
            except ValueError:
                continue
        achadas.append((m.group(1), argumentos))
    return achadas


