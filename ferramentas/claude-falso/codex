#!/usr/bin/env python3
"""Codex de mentira para a bancada (vai no PATH junto com o claude falso, com CLAUDE_FALSO=1).

Fala o formato do `codex exec --json` (conferido no Codex 0.169.0): lê o pedido da entrada padrão,
escreve `thread.started`, os itens e `turn.completed`, e não chama ninguém. Os argumentos de cada
chamada ficam em $XDG_STATE_HOME/codex-falso.log.

No pedido, `[ferramenta <Nome> <detalhe> | <segundos>]` encena um item: Bash vira um comando, Edit e
Write uma mudança de arquivo, Pensa um raciocínio; no app-server, Ver é o `view_image` de um arquivo
da pasta (o item `imageView`, só com o caminho) e Print, uma ferramenta MCP que devolve uma imagem
em base64. `[falha]` termina o turno com erro.

Aprovação no app-server, como no 0.169.0 (conferido em 24/11/2026): com a política `untrusted` (os
modos Manual e Aceitar edições do Vitral), cada Bash, Edit e Write pede aprovação
(`item/commandExecution/requestApproval` ou `item/fileChange/requestApproval`, com id numérico) e
espera a resposta; com `on-request` (Planejar e Automático), só o comando com "curl" pede, com o
motivo "precisa da rede". Depois da resposta vem o `serverRequest/resolved`; o `decline` deixa o
item `declined` e o turno segue, e o `cancel` para o turno.
`codex debug models` devolve um catálogo pequeno, e `codex --version` diz a versão
(CODEX_FALSO_VERSAO, por padrão 0.169.0), como o de verdade: "codex-cli 0.169.0".
"""
import json
import os
import re
import sys
import time
import uuid
import threading

def png_de_mentira(largura=640, altura=400):
    """Um PNG de verdade em base64 (RGB, sem biblioteca), para o `[ferramenta Print x]`."""
    import base64
    import struct
    import zlib

    def bloco(tipo, dados):
        return struct.pack(">I", len(dados)) + tipo + dados + struct.pack(">I", zlib.crc32(tipo + dados) & 0xFFFFFFFF)

    linhas = b"".join(b"\x00" + bytes((40, 110 + y * 100 // altura, 220)) * largura for y in range(altura))
    png = (b"\x89PNG\r\n\x1a\n" + bloco(b"IHDR", struct.pack(">IIBBBBB", largura, altura, 8, 2, 0, 0, 0))
           + bloco(b"IDAT", zlib.compress(linhas, 6)) + bloco(b"IEND", b""))
    return base64.b64encode(png).decode()


FERRAMENTA = re.compile(r"\[ferramenta ([A-Za-z]+) ([^\]|]+?)(?:\s*\|\s*(\d+))?\]")
SAIDA = threading.Lock()


def emitir(evento):
    with SAIDA:
        print(json.dumps(evento, ensure_ascii=False), flush=True)


def anotar(args):
    estado = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    try:
        os.makedirs(estado, exist_ok=True)
        with open(os.path.join(estado, "codex-falso.log"), "a", encoding="utf-8") as log:
            log.write(json.dumps({"cwd": os.getcwd(), "args": args}, ensure_ascii=False) + "\n")
    except OSError:
        pass


def catalogo():
    modelo = lambda slug, nome, descricao, visivel="list": {
        "slug": slug, "display_name": nome, "description": descricao, "visibility": visivel}
    print(json.dumps({"models": [
        modelo("gpt-falso-sol", "GPT-Falso-Sol", "O modelo de trabalho do codex de mentira."),
        modelo("gpt-falso-luna", "GPT-Falso-Luna", "Rápido, para tarefas fáceis."),
        modelo("codex-auto-review", "Codex Auto Review", "Não aparece no seletor.", "hide"),
    ]}))


def valor_de(args, chave):
    return next((args[i + 1] for i, a in enumerate(args[:-1]) if a == chave), None)


def servidor():
    """Mesmo JSON-RPC do app-server, com o stdin aberto e turn/steer durante a ferramenta."""
    thread = str(uuid.uuid4())
    modelo = "gpt-falso-sol"
    turno = None
    fim = threading.Event()
    mensagens = []
    trabalhador = None
    politica = "never"
    respostas = {}
    aguardando = threading.Condition()
    proximo_pedido = [0]

    def pedir(metodo, params):
        """Um pedido do servidor ao Vitral; devolve a decisão (sem resposta, `cancel`)."""
        with aguardando:
            n = proximo_pedido[0]
            proximo_pedido[0] += 1
        emitir({"method": metodo, "id": n, "params": dict(params, threadId=thread, turnId=turno)})
        with aguardando:
            while n not in respostas and not fim.is_set():
                aguardando.wait(0.2)
            resposta = respostas.pop(n, None)
        evento("serverRequest/resolved", {"threadId": thread, "requestId": n})
        return ((resposta or {}).get("result") or {}).get("decision", "cancel")

    def precisa_perguntar(nome, detalhe):
        if politica == "untrusted":
            return nome in ("Bash", "Edit", "Write")
        return politica == "on-request" and nome == "Bash" and "curl" in detalhe

    def evento(method, params): emitir({"method": method, "params": params})
    def item(valor, terminado=False):
        evento("item/completed" if terminado else "item/started", {"threadId": thread, "turnId": turno, "item": valor})

    def trabalhar(pedido):
        nonlocal turno
        # A revisão do turno do outro agente (Vitral 0.9.6): só lê. As ferramentas citadas no que
        # o outro fez não são dele: em vez delas, olha o diff da pasta, por 2 s.
        revisando = "responda só: Nada a acrescentar" in pedido
        ferramentas = [("Bash", "git diff --stat", "2")] if revisando else FERRAMENTA.findall(pedido)
        for n, (nome, detalhe, segundos) in enumerate(ferramentas):
            if fim.is_set(): break
            detalhe = detalhe.strip()
            if nome == "Pensa":
                valor = {"id": f"item_{n}", "type": "reasoning", "summary": [], "content": []}
            elif nome == "Ver":
                # O `view_image` de verdade (0.169.0): o item `imageView`, só com o caminho.
                valor = {"id": f"item_{n}", "type": "imageView", "path": os.path.join(os.getcwd(), detalhe)}
            elif nome == "Print":
                valor = {"id": f"item_{n}", "type": "mcpToolCall", "server": "chrome-devtools", "tool": "take_screenshot",
                         "status": "inProgress", "arguments": {}, "result": None, "error": None}
            elif nome in ("Edit", "Write"):
                caminho = os.path.join(os.getcwd(), detalhe)
                valor = {"id": f"item_{n}", "type": "fileChange", "status": "inProgress", "changes": [{
                    "path": caminho, "kind": {"type": "add" if nome == "Write" else "update"},
                    "diff": "@@ -1 +1 @@\n-antes\n+depois"}]}
            else:
                valor = {"id": f"item_{n}", "type": "commandExecution", "status": "inProgress", "command": detalhe,
                         "cwd": os.getcwd(), "commandActions": [], "aggregatedOutput": None, "exitCode": None}
            item(valor)
            if precisa_perguntar(nome, detalhe):
                if nome == "Bash":
                    decisao = pedir("item/commandExecution/requestApproval", {"kind": "command", "itemId": valor["id"],
                        "command": f"/bin/bash -lc '{detalhe}'", "cwd": os.getcwd(), "commandActions": [],
                        "reason": "precisa da rede" if "curl" in detalhe else None,
                        "availableDecisions": ["accept", "cancel"]})
                else:
                    decisao = pedir("item/fileChange/requestApproval", {"itemId": valor["id"], "reason": None, "grantRoot": None})
                if decisao != "accept":
                    valor["status"] = "declined"
                    item(valor, True)
                    if decisao == "cancel":
                        fim.set()
                        break
                    continue
            if fim.wait(int(segundos) if segundos else 3): break
            if nome == "Pensa": valor["summary"] = [detalhe]
            elif nome == "Ver": pass
            elif nome == "Print":
                # O resultado de um MCP no app-server: os blocos do MCP, com a imagem em `data`.
                valor.update(status="completed", result={"content": [
                    {"type": "text", "text": "Took a screenshot of the current page's viewport."},
                    {"type": "image", "data": png_de_mentira(), "mimeType": "image/png"}],
                    "structuredContent": None, "_meta": None})
            elif nome in ("Edit", "Write"):
                valor["status"] = "completed"
                try:
                    os.makedirs(os.path.dirname(caminho), exist_ok=True)
                    with open(caminho, "w", encoding="utf-8") as arq: arq.write("depois\n")
                except OSError: pass
            else: valor.update(status="completed", aggregatedOutput=f"(codex falso) saída de: {detalhe}\n", exitCode=0)
            item(valor, True)
        interrompido = fim.is_set()
        texto = "(codex falso) Recebi: " + " | ".join(mensagens)
        # Na dupla do Vitral, a vez de revisar o outro agente: revisa e não acrescenta nada (a rodada para).
        # Com `[revisor-acha]` no que o usuário pediu, a revisão tem achado.
        if revisando and "[revisor-acha]" in pedido:
            texto = ("(codex falso) Dois pontos no que o Claude mudou:\n\n"
                     "1. **`carrinho.py`, linha 12:** o desconto pode ficar maior que o subtotal, e o total sai negativo.\n"
                     "2. **Faltou teste** para o cupom vencido.")
        elif revisando:
            texto = "Nada a acrescentar."
        if not interrompido: item({"id": "resposta", "type": "agentMessage", "text": texto}, True)
        falhou = "[falha]" in pedido
        evento("turn/completed", {"threadId": thread, "turn": {"id": turno,
               "status": "interrupted" if interrompido else "failed" if falhou else "completed", "items": [],
               "error": {"message": "(codex falso) falha pedida"} if falhou else None}})
        turno = None

    for linha in sys.stdin:
        try: v = json.loads(linha)
        except ValueError: continue
        metodo, params, id_ = v.get("method"), v.get("params", {}), v.get("id")
        if metodo is None and id_ is not None:
            # A resposta do Vitral a um pedido de aprovação.
            anotar(["resposta", id_, v.get("result")])
            with aguardando:
                respostas[id_] = v
                aguardando.notify_all()
            continue
        anotar(["rpc", metodo, params.get("input", []), params.get("approvalPolicy"), params.get("sandbox")])
        politica = params.get("approvalPolicy") or politica
        if metodo == "initialize": emitir({"id": id_, "result": {"userAgent": "codex-falso"}})
        elif metodo in ("thread/start", "thread/resume"):
            thread = params.get("threadId") or thread
            modelo = params.get("model") or modelo
            emitir({"id": id_, "result": {"thread": {"id": thread, "turns": []}, "model": modelo}})
        elif metodo == "turn/start":
            turno = str(uuid.uuid4())
            mensagens = [p["text"] for p in params.get("input", []) if p.get("type") == "text"]
            fim.clear()
            emitir({"id": id_, "result": {"turn": {"id": turno, "status": "inProgress", "items": []}}})
            evento("turn/started", {"threadId": thread, "turn": {"id": turno, "status": "inProgress", "items": []}})
            trabalhador = threading.Thread(target=trabalhar, args=("\n".join(mensagens),))
            trabalhador.start()
        elif metodo == "turn/steer":
            if not turno or params.get("expectedTurnId") != turno:
                emitir({"id": id_, "error": {"code": -32600, "message": "no active turn"}})
            else:
                mensagens.extend(p["text"] for p in params.get("input", []) if p.get("type") == "text")
                emitir({"id": id_, "result": {"turnId": turno}})
        elif metodo == "turn/interrupt":
            fim.set()
            emitir({"id": id_, "result": {}})
    fim.set()
    if trabalhador: trabalhador.join(timeout=3)
    return 0


def main():
    args = sys.argv[1:]
    anotar(args)
    if args == ["--version"]:
        print(f"codex-cli {os.environ.get('CODEX_FALSO_VERSAO', '0.169.0')}")
        return
    if args[:2] == ["debug", "models"]:
        return catalogo()
    if args and args[0] == "app-server":
        return servidor()
    if not args or args[0] != "exec":
        print("codex falso: só sei `exec` e `debug models`", file=sys.stderr)
        return 2
    retomada = args[2] if len(args) > 2 and args[1] == "resume" else None
    pedido = sys.stdin.read()
    emitir({"type": "thread.started", "thread_id": retomada or str(uuid.uuid4())})
    emitir({"type": "turn.started"})
    if "[falha]" in pedido:
        erro = "(codex falso) o turno falhou de propósito."
        emitir({"type": "error", "message": erro})
        emitir({"type": "turn.failed", "error": {"message": erro}})
        return 1
    n = 0
    for nome, detalhe, segundos in FERRAMENTA.findall(pedido):
        detalhe, espera = detalhe.strip(), int(segundos) if segundos else 3
        id_ = f"item_{n}"
        n += 1
        if nome == "Pensa":
            emitir({"type": "item.started", "item": {"id": id_, "type": "reasoning", "text": ""}})
            time.sleep(espera)
            emitir({"type": "item.completed", "item": {"id": id_, "type": "reasoning", "text": detalhe}})
        elif nome in ("Edit", "Write"):
            mudanca = [{"path": os.path.join(os.getcwd(), detalhe), "kind": "add" if nome == "Write" else "update"}]
            emitir({"type": "item.started", "item": {"id": id_, "type": "file_change", "changes": mudanca, "status": "in_progress"}})
            time.sleep(espera)
            emitir({"type": "item.completed", "item": {"id": id_, "type": "file_change", "changes": mudanca, "status": "completed"}})
        else:
            comando = f'/bin/bash -lc "{detalhe}"'
            emitir({"type": "item.started", "item": {"id": id_, "type": "command_execution", "command": comando,
                                                     "aggregated_output": "", "exit_code": None, "status": "in_progress"}})
            time.sleep(espera)
            emitir({"type": "item.completed", "item": {"id": id_, "type": "command_execution", "command": comando,
                                                       "aggregated_output": f"(codex falso) saída de: {detalhe}\n",
                                                       "exit_code": 0, "status": "completed"}})
    modelo = valor_de(args, "-m") or "o padrão"
    sandbox = next((a for a in args if a.startswith("sandbox_mode=")), "sandbox_mode=?")
    como = "retomei a conversa" if retomada else "conversa nova"
    emitir({"type": "item.completed", "item": {"id": f"item_{n}", "type": "agent_message", "text":
            f"(codex falso) {como}, modelo {modelo}, {sandbox}. Li: {pedido.strip()[:200]}"}})
    emitir({"type": "turn.completed", "usage": {"input_tokens": 1000, "cached_input_tokens": 0, "output_tokens": 20}})
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
